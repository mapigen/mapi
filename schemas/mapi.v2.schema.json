{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MAPI v2 Service Definition Schema",
  "description": "JSON Schema specification for compiled MAPI service payloads (.mapi.json and .mapi.json.zst), compliant with JSON Schema Draft 2020-12.",
  "type": "object",
  "$defs": {
    "server": {
      "type": "object",
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "variables": { "type": ["object", "null"] }
      },
      "required": ["url"]
    },
    "parameter": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "in": {
          "type": "string",
          "enum": ["query", "path", "header", "cookie", "body"]
        },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "schema": { "type": "object" }
      },
      "required": ["name", "in"]
    },
    "parameter_ref": {
      "type": "object",
      "properties": {
        "$ref": {
          "type": "string",
          "pattern": "^#/components/parameters/[a-zA-Z0-9._-]+$"
        }
      },
      "required": ["$ref"]
    },
    "operation": {
      "type": "object",
      "properties": {
        "service": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS", "TRACE"]
        },
        "operationId": { "type": ["string", "null"] },
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "deprecated": { "type": "boolean" },
        "parameters": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/parameter" },
              { "$ref": "#/$defs/parameter_ref" }
            ]
          }
        }
      },
      "required": ["service", "path", "method", "parameters"]
    }
  },
  "properties": {
    "format_version": {
      "type": "integer",
      "minimum": 3
    },
    "service_name": {
      "type": "string",
      "minLength": 1
    },
    "servers": {
      "type": "array",
      "items": { "$ref": "#/$defs/server" }
    },
    "components": {
      "type": "object",
      "properties": {
        "parameters": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z0-9._-]+$": {
              "$ref": "#/$defs/parameter"
            }
          }
        },
        "schemas": {
          "type": "object"
        }
      },
      "required": ["parameters"]
    },
    "operations": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_./-]+$": {
          "$ref": "#/$defs/operation"
        }
      }
    }
  },
  "required": [
    "format_version",
    "service_name",
    "servers",
    "components",
    "operations"
  ]
}
